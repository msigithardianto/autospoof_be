# Dari Discord Developer Portal -> Bot -> Reset Token (JANGAN di-commit)
DISCORD_TOKEN=
# Application ID: General Information -> Application ID
CLIENT_ID=
# Opsional: isi ID server supaya slash command langsung muncul (tanpa tunggu ~1 jam)
GUILD_ID=
# String QRIS statis milikmu (hasil scan/decode gambar QRIS, diawali 000201...)
QRIS_STRING=
# Fitur AI (gratis): pakai penyedia yang kompatibel OpenAI. Default = Groq.
# Groq   : AI_BASE_URL=https://api.groq.com/openai/v1                    key dari console.groq.com
# Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  key dari aistudio.google.com
AI_API_KEY=
AI_BASE_URL=
# Opsional: nama model (default llama-3.3-70b-versatile). Untuk Gemini mis. gemini-2.0-flash
AI_MODEL=
# Opsional: ID channel yang semua chat-nya dijawab AI (tanpa perlu mention)
AI_CHANNEL_ID=
