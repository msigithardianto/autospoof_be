# Dari Discord Developer Portal -> Bot -> Reset Token (JANGAN di-commit)
DISCORD_TOKEN=
# Application ID: General Information -> Application ID
CLIENT_ID=
# Opsional: isi ID server supaya slash command langsung muncul (tanpa tunggu ~1 jam)
GUILD_ID=
# String QRIS statis milikmu (hasil scan/decode gambar QRIS, diawali 000201...)
QRIS_STRING=
# Fitur AI (gratis): pakai penyedia yang kompatibel OpenAI. Default = Groq.
# Groq   : AI_BASE_URL=https://api.groq.com/openai/v1                    key dari console.groq.com
# Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  key dari aistudio.google.com
AI_API_KEY=
AI_BASE_URL=
# Opsional: nama model (default llama-3.3-70b-versatile). Untuk Gemini mis. gemini-2.0-flash
AI_MODEL=
# Opsional: ID channel yang semua chat-nya dijawab AI (tanpa perlu mention). Banyak channel: pisahkan dengan koma
AI_CHANNEL_ID=
# Keamanan: ID server yang diizinkan (pisahkan dengan koma). Default = GUILD_ID. Bot otomatis keluar dari server lain.
ALLOWED_GUILD_IDS=
# Opsional: channel untuk notifikasi (mis. bot ditambahkan ke server tak dikenal). Kosong = dikirim lewat DM ke pemilik bot.
LOG_CHANNEL_ID=

# --- VOLT.STORE (web toko) ---
# Kunci rahasia bersama dengan web (BOT_API_KEY di Vercel). Min. 32 karakter acak.
STORE_API_KEY=
# URL web toko (untuk tombol status di Discord), mis. https://store-navy-rho.vercel.app
STORE_URL=
# Channel tempat embed order toko resmi + tombol admin dikirim (order toko seller dikirim via DM ke seller)
ORDER_CHANNEL_ID=


